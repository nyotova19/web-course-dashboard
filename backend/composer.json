{
    "name": "webcourse/backend",
    "description": "Web Course Dashboard - PHP Backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
         }
    },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "lint": "phpstan analyse src public --level=5 --no-progress",
    "style": "phpcs --standard=PSR12 --warning-severity=0 src public tests"
    },
    "config": {
        "optimize-autoloader": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
